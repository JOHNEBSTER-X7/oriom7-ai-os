# PostgreSQL URL enables durable accessibility profile storage.
# Example: postgresql://oriom7:change-me@localhost:5432/oriom7
DATABASE_URL=

# Development only. Never enable this on a public or production deployment.
ORIOM7_ALLOW_DEV_USER_HEADER=false

# Managed OIDC resource-server validation (all three values are required together).
# Configure the issuer, API audience and JWKS endpoint from your identity provider.
ORIOM7_OIDC_ISSUER=
ORIOM7_OIDC_AUDIENCE=
ORIOM7_OIDC_CLIENT_ID=
ORIOM7_OIDC_JWKS_URL=

# Stripe server-side integration. Never expose these values to browser variables.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ORIOM7_STRIPE_PRICE_BUILDER_MONTHLY=
ORIOM7_STRIPE_PRICE_BUSINESS_MONTHLY=
ORIOM7_BILLING_SUCCESS_URL=https://your-domain.example/account?checkout=success
ORIOM7_BILLING_CANCEL_URL=https://your-domain.example/account?checkout=cancel

# Optional LibreTranslate-compatible provider (trusted HTTPS endpoint only).
ORIOM7_TRANSLATION_ENDPOINT=
ORIOM7_TRANSLATION_API_KEY=

# Optional OCR provider endpoint. Must implement ORIOM7 OCR JSON response contract.
ORIOM7_OCR_ENDPOINT=
ORIOM7_OCR_API_KEY=

# Optional speech-to-text provider (trusted HTTPS endpoint; provider returns JSON transcript contract).
ORIOM7_SPEECH_ENDPOINT=
ORIOM7_SPEECH_API_KEY=

# Optional text-to-speech provider (trusted HTTPS endpoint; returns audio bytes).
ORIOM7_TTS_ENDPOINT=
ORIOM7_TTS_API_KEY=

# Optional visual question-answering provider. Implements ORIOM7 JSON image request/response contract.
ORIOM7_VISION_ENDPOINT=
ORIOM7_VISION_API_KEY=
ORIOM7_VISION_MODEL=default

# Optional image embedding provider for owner-scoped image similarity search
ORIOM7_VISUAL_EMBEDDING_ENDPOINT=
ORIOM7_VISUAL_EMBEDDING_API_KEY=
ORIOM7_VISUAL_EMBEDDING_MODEL=default
ORIOM7_VISUAL_EMBEDDING_DIMENSIONS=1024

# Optional self-hosted vLLM OpenAI-compatible inference endpoint.
# Example base URL: http://vllm:8000/v1 (server exposes /chat/completions).
# Keep the endpoint on a private network; never expose model-server credentials to browsers.
ORIOM7_VLLM_BASE_URL=
ORIOM7_VLLM_API_KEY=
ORIOM7_VLLM_MODEL=
# Select vllm as primary or fallback only after load, quality and security testing.
# ORIOM7_MODEL_PRIMARY=vllm
# ORIOM7_MODEL_FALLBACK=openai
