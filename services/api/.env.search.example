# Optional external web search. Keep the key in a secret manager.
SERPAPI_API_KEY=
# Two-letter country code used for external Google results.
ORIOM7_SEARCH_COUNTRY=gb

# Separate secret for trusted ingestion operators; generate a long random value.
ORIOM7_INGESTION_TOKEN=

# Optional pgvector multilingual semantic retrieval; apply migration 005 first.
ORIOM7_SEMANTIC_SEARCH_ENABLED=false
ORIOM7_EMBEDDING_API_KEY=
ORIOM7_EMBEDDING_BASE_URL=https://api.openai.com/v1
ORIOM7_EMBEDDING_MODEL=text-embedding-3-small
# Set true only when strict result-language filtering is desired; default false enables cross-language matches.
ORIOM7_SEMANTIC_LANGUAGE_FILTER=false

# Optional automatic knowledge-graph candidate extraction after queue-worker indexing.
# Requires configured ORIOM7 model provider credentials and model ID.
ORIOM7_KNOWLEDGE_EXTRACTION_ENABLED=false
# Comma-separated trusted authenticated subject IDs permitted to review graph assertions.
ORIOM7_GRAPH_REVIEWER_SUBJECTS=
# Configure the same strong secret privately in API and Next.js server environments.
ORIOM7_GRAPH_REVIEW_TOKEN=

# Apply migration 009 to enable persisted, user-scoped autonomous research runs.
