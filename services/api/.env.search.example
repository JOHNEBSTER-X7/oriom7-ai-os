# Optional external web search. Keep the key in a secret manager.
SERPAPI_API_KEY=
ORIOM7_SEARCH_COUNTRY=gb

# Separate secret for trusted ingestion operators; generate a long random value.
ORIOM7_INGESTION_TOKEN=

# Optional pgvector multilingual semantic retrieval; apply migrations 005 and 011 first.
ORIOM7_SEMANTIC_SEARCH_ENABLED=false
ORIOM7_EMBEDDING_API_KEY=
ORIOM7_EMBEDDING_BASE_URL=https://api.openai.com/v1
ORIOM7_EMBEDDING_MODEL=text-embedding-3-small
# Must match a dimension supported by the selected model/provider. Default: 1536.
# pgvector vector supports up to 16000 dimensions; HNSW vector indexing is used up to 2000.
# Above 2000 dimensions ORIOM7 uses exact cosine ranking (higher compute cost).
ORIOM7_EMBEDDING_DIMENSIONS=1536
ORIOM7_SEMANTIC_LANGUAGE_FILTER=false

ORIOM7_KNOWLEDGE_EXTRACTION_ENABLED=false
ORIOM7_GRAPH_REVIEWER_SUBJECTS=
ORIOM7_GRAPH_REVIEW_TOKEN=
ORIOM7_RESEARCH_WORKER_ID=
