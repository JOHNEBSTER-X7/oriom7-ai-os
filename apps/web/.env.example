# Server-side API origin used by Next.js route handlers.
# Do not expose provider secrets or private API credentials in NEXT_PUBLIC variables.
ORIOM7_API_URL=http://localhost:8000

# Managed OIDC authorization-code + PKCE sign-in. Use a confidential web client.
ORIOM7_OIDC_AUTHORIZATION_ENDPOINT=
ORIOM7_OIDC_TOKEN_ENDPOINT=
ORIOM7_OIDC_ISSUER=
ORIOM7_OIDC_JWKS_URL=
ORIOM7_OIDC_CLIENT_ID=
ORIOM7_OIDC_CLIENT_SECRET=
ORIOM7_OIDC_AUDIENCE=
ORIOM7_OIDC_REDIRECT_URI=https://your-domain.example/api/auth/callback
ORIOM7_OIDC_SCOPES=openid profile email
