{
  "openapi": "3.1.0",
  "info": {
    "title": "ORIOM7 API",
    "version": "1.0.0",
    "description": "Initial versioned contract for the ORIOM7 hybrid search and assistant platform."
  },
  "servers": [
    {
      "url": "https://api.example.com/v1",
      "description": "Placeholder; replace with the configured deployment URL."
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Service status",
        "responses": {
          "200": {
            "description": "Service is responding",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/models": {
      "get": {
        "operationId": "listConfiguredModels",
        "summary": "List configured model providers",
        "description": "Returns configured provider and model identifiers with enabled capabilities. Never returns API credentials.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Configured model catalogue"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/search": {
      "post": {
        "operationId": "search",
        "summary": "Run hybrid search",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "oriom7_index",
                        "external"
                      ]
                    },
                    "default": [
                      "oriom7_index"
                    ],
                    "minItems": 1,
                    "maxItems": 2
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50,
                    "default": 10
                  },
                  "language": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 35
                  },
                  "region": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked search results"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "429": {
            "description": "Rate limit or quota exceeded"
          },
          "503": {
            "description": "No requested search source is configured"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Authenticated search over the permission-aware ORIOM7 first-party PostgreSQL index and optionally configured external search providers. Results include canonical source URLs, retrieval timestamps and provenance. Requested but unconfigured providers are reported as unavailable."
      }
    },
    "/assistant/responses": {
      "post": {
        "operationId": "createAssistantResponse",
        "summary": "Create an evidence-aware assistant response",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "string",
                    "minLength": 1
                  },
                  "conversation_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "chat",
                      "research",
                      "coding",
                      "business",
                      "education"
                    ],
                    "default": "chat"
                  },
                  "stream": {
                    "type": "boolean",
                    "default": true
                  },
                  "grounding": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "search": {
                        "type": "boolean",
                        "default": true
                      },
                      "minimum_sources": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 20,
                        "default": 1
                      }
                    }
                  },
                  "max_output_tokens": {
                    "type": "integer",
                    "minimum": 64,
                    "maximum": 8192,
                    "default": 1200
                  }
                },
                "required": [
                  "input"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assistant response or event stream"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "429": {
            "description": "Rate limit or quota exceeded"
          },
          "502": {
            "description": "All configured model providers failed"
          },
          "503": {
            "description": "Model provider or requested retrieval service is not configured or unavailable"
          }
        },
        "description": "Generate a non-streaming response using configured model providers, retrieved ORIOM7 evidence and the caller's saved accessibility preferences. The response exposes source references and reports citation-label validation. External retrieval is used only when configured.",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/usage": {
      "get": {
        "operationId": "getUsage",
        "summary": "Get caller usage summary",
        "responses": {
          "200": {
            "description": "Usage summary"
          }
        }
      }
    },
    "/assistant/presentation": {
      "post": {
        "operationId": "createAssistantPresentation",
        "summary": "Resolve accessibility-aware assistant response directives",
        "description": "Returns structured presentation directives derived from the authenticated user's saved profile and optional temporary overrides. This endpoint does not generate assistant content or invoke a model provider. Citations, uncertainty and safety warnings are always preserved.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "overrides": {
                    "type": "object",
                    "description": "Temporary, non-persisted accessibility profile overrides."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Presentation directives ready for the assistant orchestrator"
          },
          "401": {
            "description": "Authentication required"
          },
          "422": {
            "description": "Invalid profile override"
          }
        }
      }
    },
    "/knowledge/entities/{entity_id}/resolution-candidates": {
      "get": {
        "operationId": "suggestEntityResolutionCandidates",
        "summary": "Suggest possible duplicate entities",
        "description": "Similarity-ranked suggestions only; no automatic merging.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "entity_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Candidate identities for human review"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Entity not found"
          }
        }
      }
    },
    "/knowledge/assertions/potential-conflicts": {
      "get": {
        "operationId": "listPotentialAssertionConflicts",
        "summary": "Find potentially inconsistent accepted claims",
        "description": "Only use for predicates that should be single-valued. Reports overlapping accepted claims with different objects for human assessment, not verified contradictions.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "predicate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            }
          },
          {
            "name": "single_valued",
            "in": "query",
            "required": true,
            "schema": {
              "type": "boolean",
              "enum": [
                true
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Potential inconsistencies and evidence"
          },
          "400": {
            "description": "Single-valued predicate confirmation required"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/knowledge/entities/{entity_id}/paths": {
      "get": {
        "operationId": "getBoundedKnowledgePaths",
        "summary": "Traverse bounded accepted knowledge paths",
        "description": "Returns evidence-linked paths of up to three edges; does not establish causation or transitive truth.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "entity_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "max_depth",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 2
            }
          },
          {
            "name": "as_of",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evidence-linked graph paths"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Entity not found"
          }
        }
      }
    },
    "/knowledge/documents/{document_id}/extract": {
      "post": {
        "operationId": "extractKnowledgeCandidates",
        "summary": "Extract graph candidates from an indexed document",
        "description": "Model proposals require verbatim evidence excerpts and remain unverified pending human review.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Extraction completed or no candidates found"
          },
          "401": {
            "description": "Authentication required"
          },
          "422": {
            "description": "Document is not eligible"
          },
          "502": {
            "description": "Model extraction failed"
          },
          "503": {
            "description": "Model provider or database unavailable"
          }
        }
      }
    },
    "/knowledge/entities/{entity_id}": {
      "get": {
        "operationId": "getKnowledgeEntityNeighbourhood",
        "summary": "Read accepted one-hop graph relationships",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "entity_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Entity and evidence-backed accepted relationships"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Entity not found"
          }
        }
      }
    },
    "/knowledge/entities": {
      "get": {
        "operationId": "findKnowledgeEntities",
        "summary": "Find canonical graph entities and aliases",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching entities"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/knowledge/observations": {
      "post": {
        "operationId": "submitKnowledgeObservations",
        "summary": "Submit evidence-linked graph assertions",
        "description": "Creates unverified candidates. Optional validity dates must be supported by source evidence.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "202": {
            "description": "Assertions submitted for human review"
          },
          "401": {
            "description": "Authentication required"
          },
          "422": {
            "description": "Invalid request or ineligible evidence"
          }
        }
      }
    },
    "/knowledge/assertions/{assertion_id}/review": {
      "post": {
        "operationId": "reviewKnowledgeAssertion",
        "summary": "Accept or reject a graph candidate",
        "description": "Requires authenticated identity and the separate graph review token.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "assertion_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-ORIOM7-GRAPH-REVIEW-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Review recorded"
          },
          "401": {
            "description": "Invalid reviewer token or unauthenticated"
          },
          "404": {
            "description": "Assertion not reviewable"
          },
          "503": {
            "description": "Review not configured"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
