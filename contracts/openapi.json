{
  "openapi": "3.1.0",
  "info": {
    "title": "ORIOM7 API",
    "version": "1.0.0",
    "description": "Initial versioned contract for the ORIOM7 hybrid search and assistant platform."
  },
  "servers": [
    {
      "url": "https://api.example.com/v1",
      "description": "Placeholder; replace with the configured deployment URL."
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Service status",
        "responses": {
          "200": {
            "description": "Service is responding",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/models": {
      "get": {
        "operationId": "listConfiguredModels",
        "summary": "List configured model providers",
        "description": "Returns configured provider and model identifiers with enabled capabilities. Never returns API credentials.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Configured model catalogue"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/search": {
      "post": {
        "operationId": "search",
        "summary": "Run hybrid search",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "oriom7_index",
                        "external"
                      ]
                    },
                    "default": [
                      "oriom7_index"
                    ],
                    "minItems": 1,
                    "maxItems": 2
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50,
                    "default": 10
                  },
                  "language": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 35
                  },
                  "region": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked search results"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "429": {
            "description": "Rate limit or quota exceeded"
          },
          "503": {
            "description": "No requested search source is configured"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Authenticated search over the permission-aware ORIOM7 first-party PostgreSQL index and optionally configured external search providers. Results include canonical source URLs, retrieval timestamps and provenance. Requested but unconfigured providers are reported as unavailable."
      }
    },
    "/assistant/responses": {
      "post": {
        "operationId": "createAssistantResponse",
        "summary": "Create an evidence-aware assistant response",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "string",
                    "minLength": 1
                  },
                  "conversation_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "chat",
                      "research",
                      "coding",
                      "business",
                      "education"
                    ],
                    "default": "chat"
                  },
                  "stream": {
                    "type": "boolean",
                    "default": true
                  },
                  "grounding": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "search": {
                        "type": "boolean",
                        "default": true
                      },
                      "minimum_sources": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 20,
                        "default": 1
                      }
                    }
                  },
                  "max_output_tokens": {
                    "type": "integer",
                    "minimum": 64,
                    "maximum": 8192,
                    "default": 1200
                  }
                },
                "required": [
                  "input"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assistant response or event stream"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "429": {
            "description": "Rate limit or quota exceeded"
          },
          "502": {
            "description": "All configured model providers failed"
          },
          "503": {
            "description": "Model provider or requested retrieval service is not configured or unavailable"
          }
        },
        "description": "Generate a non-streaming response using configured model providers, retrieved ORIOM7 evidence and the caller's saved accessibility preferences. The response exposes source references and reports citation-label validation. External retrieval is used only when configured.",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/usage": {
      "get": {
        "operationId": "getUsage",
        "summary": "Get caller usage summary",
        "responses": {
          "200": {
            "description": "Usage summary"
          }
        }
      }
    },
    "/assistant/presentation": {
      "post": {
        "operationId": "createAssistantPresentation",
        "summary": "Resolve accessibility-aware assistant response directives",
        "description": "Returns structured presentation directives derived from the authenticated user's saved profile and optional temporary overrides. This endpoint does not generate assistant content or invoke a model provider. Citations, uncertainty and safety warnings are always preserved.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "overrides": {
                    "type": "object",
                    "description": "Temporary, non-persisted accessibility profile overrides."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Presentation directives ready for the assistant orchestrator"
          },
          "401": {
            "description": "Authentication required"
          },
          "422": {
            "description": "Invalid profile override"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
